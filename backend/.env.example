PORT=5555
MONGODB_URL=mongodb://localhost:27018/rent-cars
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Restricts CORS to this origin in production; leave unset in local dev
FRONTEND_URL=

# Optional on a persistent host (falls back to local disk). REQUIRED on Vercel —
# serverless functions have no writable/servable local disk for uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: enables the AI natural-language search route
ANTHROPIC_API_KEY=
